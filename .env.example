# Hermes TradeDesk — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to ~/.hermes/.env (and fill in your real credentials)
# or paste the same variable NAMES into your real ~/.hermes/.env.
#
# DO NOT COMMIT YOUR ~/.hermes/.env TO GIT. It contains credentials.
#
# Variable naming convention (generic, public-safe):
#   <EXCHANGE>_<ALIAS>_<FIELD>
# where:
#   <EXCHANGE> is the exchange code (TELEGRAM, RAYDIUM, RISE, ...)
#   <ALIAS>    is the account ALIAS (use EXAMPLE or ACCOUNT1)
#   <FIELD>    is the credential name (API_KEY, SECRET_KEY, ...).
#
# Account discovery scans the process environment for these variables
# at startup. The /trade wizard never reads .env directly.
# -----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Telegram bot (REQUIRED for /trade)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# 2. Raydium / Orderly (perps.raydium.io)
# Pattern: RAYDIUM_<ALIAS>_ACCOUNT_ID / _API_KEY / _SECRET_KEY
# Optional: RAYDIUM_<ALIAS>_PRIVATE_KEY / _BROKER_ID
# ---------------------------------------------------------------------------
RAYDIUM_EXAMPLE_ACCOUNT_ID=
RAYDIUM_EXAMPLE_API_KEY=
RAYDIUM_EXAMPLE_SECRET_KEY=

# ---------------------------------------------------------------------------
# 3. Rise (RISEx perpetuals on https://app.rise.trade)
# Pattern: RISE_<ALIAS>_WALLET / _APISIGNERPRIVATE
# ---------------------------------------------------------------------------
RISE_EXAMPLE_WALLET=
RISE_EXAMPLE_APISIGNERPRIVATE=

# ---------------------------------------------------------------------------
# 4. Hyperliquid
# Pattern: HYPERLIQUID_<ALIAS>_WALLET / _API_KEY / _SECRET_KEY
# (See hyperliquid_agent.py for exact pattern.)
# ---------------------------------------------------------------------------
HYPERLIQUID_EXAMPLE_WALLET=
HYPERLIQUID_EXAMPLE_API_KEY=
HYPERLIQUID_EXAMPLE_SECRET_KEY=

# ---------------------------------------------------------------------------
# 5. AFX (afex.trade)
# ---------------------------------------------------------------------------
AFX_EXAMPLE_API_KEY=
AFX_EXAMPLE_SECRET_KEY=

# ---------------------------------------------------------------------------
# 6. Pacifica (app.pacifica.trade)
# ---------------------------------------------------------------------------
PACIFICA_EXAMPLE_API_KEY=
PACIFICA_EXAMPLE_SECRET_KEY=

# ---------------------------------------------------------------------------
# 7. Apex (omni.apeX.pro)
# ---------------------------------------------------------------------------
APEX_EXAMPLE_API_KEY=
APEX_EXAMPLE_SECRET_KEY=

# ---------------------------------------------------------------------------
# 8. Lighter (app.lighter.com)
# Pattern: LIGHTER_<ALIAS>_API_KEY / _PRIVATE_KEY
# ---------------------------------------------------------------------------
LIGHTER_EXAMPLE_API_KEY=
LIGHTER_EXAMPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Use ALIAS names that are NOT your real production ones.
# Examples used here ("EXAMPLE", "ACCOUNT1") are placeholders.
# Real values go in ~/.hermes/.env, NEVER in this template.
